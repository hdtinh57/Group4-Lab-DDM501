{
  "uid": "system-metrics", "title": "System Metrics Dashboard", "schemaVersion": 38, "version": 1, "refresh": "10s",
  "panels": [
    {"id": 1, "title": "Request rate", "type": "timeseries", "gridPos": {"h": 8,"w": 12,"x": 0,"y": 0}, "targets": [{"expr": "sum by (method, endpoint) (rate(http_requests_total[5m]))", "legendFormat": "{{method}} {{endpoint}}"}]},
    {"id": 2, "title": "P95 latency", "type": "timeseries", "gridPos": {"h": 8,"w": 12,"x": 12,"y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}]},
    {"id": 3, "title": "Error rate", "type": "stat", "gridPos": {"h": 8,"w": 12,"x": 0,"y": 8}, "targets": [{"expr": "(sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001) * 100) or vector(0)"}]},
    {"id": 4, "title": "Status distribution", "type": "piechart", "gridPos": {"h": 8,"w": 12,"x": 12,"y": 8}, "targets": [{"expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}"}]}
  ]
}
